# Cloudflare Gateway (server-side only: never prefix these with NEXT_PUBLIC_)
# GATEWAY_KEY: copy it from the gateway dashboard (Sites -> Edit -> Server-side calls)
GATEWAY_URL=https://gw.td-server.com
GATEWAY_SITE_ID=Image-Generators
GATEWAY_KEY=

# Supabase. The URL and anon key are public by design (data is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (Project Settings -> API). Never prefix with NEXT_PUBLIC_ or commit it.
# SERVICE_ROLE_SECRET is also accepted as the name.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: contact form and "backend is down" alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=600

# Legacy: only /api/generated_images/FetchRecords still reads these (it targets the old backend)
# BACKEND_URL=
# NEXT_PUBLIC_BACKEND_URL=
